# =====================================================================
# Template for the Docker Compose settings (Module 5: Dockerize).
# Copy this file to .env in the project root and replace the placeholders:
#     cp .env.example .env
# .env is git-ignored and listed in .dockerignore, so real values are never
# committed and never copied into an image. Use classroom-only passwords.
# =====================================================================

# Database the app uses (the same name as the Module 3/4 "auth" database).
MYSQL_DATABASE=auth

# Password for MySQL's root (administrator) account inside the container.
# Used by the health check, not by the app.
MYSQL_ROOT_PASSWORD=change-this-root-password

# Non-root MySQL account the app logs in as.
MYSQL_USER=gameflix_auth
MYSQL_PASSWORD=change-this-app-password

# JWT signing secret: a Base64 string that decodes to at least 32 bytes.
# Generate one with:  openssl rand -base64 32
JWT_SECRET=paste-output-of-openssl-rand-base64-32

# Ports on your Mac. Change them if something else already uses them.
MYSQL_HOST_PORT=3307
APP_HOST_PORT=8080
